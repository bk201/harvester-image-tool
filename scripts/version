#!/bin/bash

TOP_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
_VERSION_ENV="${TOP_DIR}/scripts/.version_env"

# When .git is not available, fall back to a pre-generated env file.  Run
# 'scripts/version' on a host with git access first.
if ! git -C "${TOP_DIR}" rev-parse --git-dir &>/dev/null 2>&1; then
    if [[ -f "${_VERSION_ENV}" ]]; then
        # shellcheck source=/dev/null
        source "${_VERSION_ENV}"
        return 0 2>/dev/null || true
    fi
    echo "ERROR: git is unavailable and no pre-generated scripts/.version_env was found." >&2
    echo "Run 'scripts/version' on a host with git access first." >&2
    return 1 2>/dev/null || exit 1
fi

# A repo with no commits yet (greenfield) has a git dir but no HEAD commit.
if ! git -C "${TOP_DIR}" rev-parse HEAD &>/dev/null 2>&1; then
    cat > "${_VERSION_ENV}" <<__EOF__
# Auto-generated by scripts/version — do not edit manually.
DIRTY=""
COMMIT="none"
GIT_TAG=""
VERSION="v0.0.0-dev"
__EOF__
    source "${_VERSION_ENV}"
    return 0 2>/dev/null || true
fi

if [ -n "$(git -C "${TOP_DIR}" status --porcelain --untracked-files=no)" ]; then
    DIRTY="-dirty"
fi

COMMIT=$(git -C "${TOP_DIR}" rev-parse --short HEAD)
GIT_TAG=$(git -C "${TOP_DIR}" tag -l --contains HEAD | head -n 1)

if [[ -z "$DIRTY" && -n "$GIT_TAG" ]]; then
    VERSION=$GIT_TAG
else
    VERSION="${COMMIT}${DIRTY}"
fi

cat > "${_VERSION_ENV}" <<__EOF__
# Auto-generated by scripts/version — do not edit manually.
# Refresh by running scripts/version on a host with git access.
DIRTY="${DIRTY}"
COMMIT="${COMMIT}"
GIT_TAG="${GIT_TAG}"
VERSION="${VERSION}"
__EOF__
